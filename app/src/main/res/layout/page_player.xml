<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <FrameLayout
            android:layout_width="236dp"
            android:layout_height="236dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_cover" />

            <ImageView
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_note"
                android:alpha="0.55"
                android:contentDescription="封面" />
        </FrameLayout>

        <TextView
            android:id="@+id/trackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="未选择曲目"
            android:textColor="@color/text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/trackMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="插入小尾巴后选择曲目开始播放"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <!-- 输出链路卡片 -->
        <LinearLayout
            android:id="@+id/outCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_usb"
                    android:alpha="0.7"
                    android:contentDescription="输出" />

                <TextView
                    android:id="@+id/outDevice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="系统扬声器"
                    android:textColor="@color/text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/outMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_dark"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="系统"
                    android:textColor="@color/accent"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/outFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="monospace"
                android:text="-- kHz / -- bit / -- ch"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/bitPerfectBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="● 链路待检测"
                android:textColor="@color/text_faint"
                android:textSize="11sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="#2A2E37"
            android:thumbTint="@color/accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timeCur"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="0:00"
                android:textColor="@color/text_faint"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/timeTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0:00"
                android:textColor="@color/text_faint"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/ic_prev"
                android:scaleType="fitCenter"
                android:contentDescription="上一首" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_circle_accent"
                android:padding="17dp"
                android:src="@drawable/ic_play"
                android:scaleType="fitCenter"
                android:contentDescription="播放" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/ic_next"
                android:scaleType="fitCenter"
                android:contentDescription="下一首" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnLibrary"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="11dp"
                android:src="@drawable/ic_list"
                android:scaleType="fitCenter"
                android:contentDescription="曲库" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_tune"
                android:alpha="0.5"
                android:contentDescription="音量" />

            <SeekBar
                android:id="@+id/volumeBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:max="100"
                android:progress="70"
                android:progressTint="@color/text_dim"
                android:progressBackgroundTint="#23262D"
                android:thumbTint="@color/text_dim" />
        </LinearLayout>

        <TextView
            android:id="@+id/playerHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="提示：独占直连模式下音量由 DAC 硬件控制，软件音量条会置灰。"
            android:textColor="@color/text_faint"
            android:textSize="10sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>
